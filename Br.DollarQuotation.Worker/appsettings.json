{
  "AwesomeApi": {
    "BaseUrl": "https://economia.awesomeapi.com.br/"
  },
  "QuotationWorker": {
    "Enabled": true,
    "IntervalInSeconds": 60,
    "DelayBetweenRequestsInMilliseconds": 1000,
    "CurrencyPairs": [
      "USD-BRL",
      "EUR-BRL",
      "GBP-BRL"
    ]
  },
  "InternalApi": {
    "BaseUrl": "https://localhost:7123"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "dollarquotation.exchange",
    "QuotationQueueName": "dollarquotation.quotation.queue",
    "QuotationRoutingKey": "quotation.updated"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}